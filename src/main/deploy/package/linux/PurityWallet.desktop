[Desktop Entry]
Name=PurityWallet
Comment=PurityWallet
Exec=/opt/sparrowwallet/bin/PurityWallet %U
Icon=/opt/sparrowwallet/lib/PurityWallet.png
Terminal=false
Type=Application
Categories=Finance;Network;
MimeType=application/psbt;application/bitcoin-transaction;application/pgp-signature;x-scheme-handler/bitcoin;x-scheme-handler/auth47;x-scheme-handler/lightning
StartupWMClass=PurityWallet
SingleMainWindow=true
